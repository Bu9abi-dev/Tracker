# Required. Use a long random passphrase (16+ characters).
DASHBOARD_PASSWORD=

# Required. Random string (32+ characters) used to sign session cookies.
# Rotating it logs out every device. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Data source: "csv" (Phase 1, reads /data) or "apps-script" (Phase 2, live Google Sheet).
DATA_SOURCE=csv

# Phase 2 only. Never prefix these with NEXT_PUBLIC_ — they must stay server-side.
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=
